# Refuse to push to a branch whose pull request has already merged.
#
# Why this exists: pushing new commits to a merged branch silently opens a
# SECOND pull request carrying them. It happened on `lead/T-0003-acceptance-tests`
# — PR #3 merged, three more commits went to the same branch, and PR #4 appeared
# with an auto-generated title, an empty body and no `lead-approved` label, so
# the protected-path guard failed. Nothing was broken, but the work was
# invisible until someone looked at why CI was red.
#
# The repository now also has "automatically delete head branches" enabled, so
# a merged branch normally disappears. This hook covers the case where a local
# branch outlives its remote: the delete happens on GitHub, the local copy stays,
# and the next push recreates it.
#
# HONEST LIMITATION: this fails OPEN. If `gh` is missing, unauthenticated or
# offline it warns and allows the push, because a hook that blocks all work when
# the network is down would be bypassed with --no-verify within a day, and then
# it protects nothing. It is a guardrail against a specific accident, not a
# control. The controls are branch protection and the CI label gate.

branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "main" ] || [ "$branch" = "HEAD" ]; then
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  exit 0
fi

merged=$(gh pr list --head "$branch" --state merged --json number --jq '.[0].number' 2>/dev/null) || exit 0

if [ -n "$merged" ]; then
  echo ""
  echo "Refusing to push: branch '$branch' already had PR #$merged merged."
  echo ""
  echo "Pushing here opens a second pull request carrying these commits, with no"
  echo "title, no body and no labels — so a diff touching tests/acceptance/ or"
  echo "packages/db/migrations/ fails the guard and the work goes unnoticed."
  echo ""
  echo "Start fresh instead (STANDING ORDERS A7):"
  echo ""
  echo "    git fetch origin main"
  echo "    git checkout -b <type>/<short-name> origin/main"
  echo "    git cherry-pick <your commits>   # if they are already committed here"
  echo ""
  exit 1
fi

exit 0
