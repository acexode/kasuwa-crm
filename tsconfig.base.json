{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // @kasuwa/config keeps its schemas in checked JavaScript (`// @ts-check`)
    // because apps/web/next.config.mjs imports them natively (T-0014). Every
    // project reaches them through @kasuwa/config, so every project must be
    // able to read their types. Only imported JS is affected: each project's
    // `include` still lists TypeScript only.
    "allowJs": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "baseUrl": ".",
    "paths": {
      "@kasuwa/auth-crypto": ["packages/auth-crypto/src/index.ts"],
      "@kasuwa/config": ["packages/config/src/index.ts"],
      "@kasuwa/config/feature-flags": ["packages/config/src/feature-flags.ts"],
      "@kasuwa/config/web": ["packages/config/src/web.mjs"],
      "@kasuwa/config/session": ["packages/config/src/session.mjs"],
      "@kasuwa/db": ["packages/db/src/index.ts"],
      "@kasuwa/permissions": ["packages/permissions/src/index.ts"],
      "@kasuwa/metadata-engine": ["packages/metadata-engine/src/index.ts"],
      "@kasuwa/metadata-engine/field-access-for-user": ["packages/metadata-engine/src/field-access-for-user.ts"],
      "@kasuwa/telephony-adapter": ["packages/telephony-adapter/src/index.ts"],
      "@kasuwa/channel-adapter": ["packages/channel-adapter/src/index.ts"],
      "@kasuwa/wfm-adapter": ["packages/wfm-adapter/src/index.ts"],
      "@kasuwa/storage-adapter": ["packages/storage-adapter/src/index.ts"],
      "@kasuwa/payments-adapter": ["packages/payments-adapter/src/index.ts"],
      "@kasuwa/domain-core": ["packages/domain/core/src/index.ts"],
      "@kasuwa/domain-core/provisioning": ["packages/domain/core/src/provisioning.ts"],
      "@kasuwa/ui": ["packages/ui/src/index.ts"],
      "@kasuwa/ui/components": ["packages/ui/src/components/index.ts"],
      "@kasuwa/i18n": ["packages/i18n/src/index.ts"],
      "@kasuwa/i18n/bundle": ["packages/i18n/src/bundle.ts"],
      "@kasuwa/feature-flags": ["packages/feature-flags/src/index.ts"],
      "@kasuwa/testing": ["packages/testing/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
