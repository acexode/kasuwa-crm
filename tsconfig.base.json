{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "baseUrl": ".",
    "paths": {
      "@kasuwa/auth-crypto": ["packages/auth-crypto/src/index.ts"],
      "@kasuwa/config": ["packages/config/src/index.ts"],
      "@kasuwa/config/feature-flags": ["packages/config/src/feature-flags.ts"],
      "@kasuwa/db": ["packages/db/src/index.ts"],
      "@kasuwa/permissions": ["packages/permissions/src/index.ts"],
      "@kasuwa/metadata-engine": ["packages/metadata-engine/src/index.ts"],
      "@kasuwa/telephony-adapter": ["packages/telephony-adapter/src/index.ts"],
      "@kasuwa/channel-adapter": ["packages/channel-adapter/src/index.ts"],
      "@kasuwa/wfm-adapter": ["packages/wfm-adapter/src/index.ts"],
      "@kasuwa/domain-core": ["packages/domain/core/src/index.ts"],
      "@kasuwa/domain-core/provisioning": ["packages/domain/core/src/provisioning.ts"],
      "@kasuwa/ui": ["packages/ui/src/index.ts"],
      "@kasuwa/i18n": ["packages/i18n/src/index.ts"],
      "@kasuwa/i18n/bundle": ["packages/i18n/src/bundle.ts"],
      "@kasuwa/feature-flags": ["packages/feature-flags/src/index.ts"],
      "@kasuwa/testing": ["packages/testing/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
