{
  "name": "@kasuwa/ui",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.generated.css",
    "./fonts.css": "./src/fonts.generated.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "scripts": {
