{
  "name": "@kasuwa/domain-core",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./provisioning": "./src/provisioning.ts",
