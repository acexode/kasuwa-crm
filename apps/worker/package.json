{
  "name": "@kasuwa/worker",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.js --external:pg-native",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kasuwa/config": "workspace:*",
    "@kasuwa/db": "workspace:*",
    "@kasuwa/domain-core": "workspace:*",
    "@kasuwa/metadata-engine": "workspace:*",
    "@kasuwa/permissions": "workspace:*",
    "@kasuwa/storage-adapter": "workspace:*",
    "bullmq": "^5.34.6",
    "csv-parse": "^5.6.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2"
  },
  "nx": {
    "tags": [
      "scope:app",
      "type:app"
    ]
  }
}
