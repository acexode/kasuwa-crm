{
  "name": "@kasuwa/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kasuwa/config": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": { "@types/ws": "^8.5.13", "esbuild": "^0.25.12", "tsx": "^4.19.2" },
  "nx": { "tags": ["scope:app", "type:app"] }
}
