{
  "name": "@kasuwa/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.js --external:@nestjs/microservices --external:@nestjs/websockets --external:class-transformer --external:class-validator --external:pg-native",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kasuwa/auth-crypto": "workspace:*",
    "@kasuwa/config": "workspace:*",
    "@kasuwa/db": "workspace:*",
    "@kasuwa/domain-core": "workspace:*",
    "@kasuwa/feature-flags": "workspace:*",
    "@kasuwa/metadata-engine": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2"
  },
  "nx": {
    "tags": [
      "scope:app",
      "type:app"
    ]
  },
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}
